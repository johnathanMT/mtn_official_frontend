# Copy to .env.local for local development. Never commit .env.local.

# Canonical origin. Leave unset in production to use https://myothantnaing.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudinary — found on your Cloudinary dashboard as "Cloud name".
# Required before any Cloudinary public ID in mediaControl.ts will resolve.
# Add the same key in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# C# .NET backend on Render
NEXT_PUBLIC_API_URL=http://localhost:5001
